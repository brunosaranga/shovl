# shovl backend: environment variables.
# Set these in your host's dashboard, or export them in the terminal. Django does not
# read this file by itself, and a real .env must never be committed.

# ---- Required in production --------------------------------------------------------
# A long random string, new for production. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# The API's hostname(s), comma-separated, without https://
DJANGO_ALLOWED_HOSTS=api.example.com
# The frontend's full address, without a trailing slash
CORS_ALLOWED_ORIGINS=https://shovl.example.com
# The Postgres connection string from the provider. On Neon, use the direct one
# (the hostname has no "-pooler"). sslmode=require is added if it is missing.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Development only: never set these on the host ----------------------------------
# DJANGO_DEBUG=1
# SHOVL_ALLOW_PRIVATE_TARGETS=1

# ---- Optional (defaults shown) -------------------------------------------------------
# Seconds a database connection is reused between requests (0 = a new one every request)
# DB_CONN_MAX_AGE=60
# Only when DATABASE_URL points at a transaction-mode pooler (Neon "-pooler", PgBouncer)
# DB_DISABLE_SERVER_SIDE_CURSORS=1
# How long a sign-in lasts, in minutes (960 = 16 hours)
# JWT_ACCESS_TOKEN_MINUTES=960
# Scanner limits, in seconds or bytes
# SHOVL_CONNECT_TIMEOUT=5
# SHOVL_READ_TIMEOUT=15
# SHOVL_RATE_LIMIT_READ_TIMEOUT=6
# SHOVL_SCAN_TIME_BUDGET=90
# SHOVL_MAX_REDIRECTS=5
# SHOVL_MAX_BODY_BYTES=1048576
# SHOVL_RESPONSE_TIME_CAP=30
